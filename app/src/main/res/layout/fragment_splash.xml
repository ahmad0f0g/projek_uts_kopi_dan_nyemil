<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Logo Lingkaran Placeholder -->
    <ImageView
        android:id="@+id/imgSplashLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_kopi_dan_nyemil" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Kopi dan Nyemil"
        android:textColor="@color/web_golden"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStartNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:backgroundTint="@color/web_golden"
        android:text="Start now"
        android:textColor="@color/royal_blue_dark" />
</LinearLayout>